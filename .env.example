# 선택적으로 OpenAI 임베딩을 사용할 때 환경변수에 지정한다.
# API 키 없이도 --demo 명령은 실행된다. 실제 .env 파일은 Git에 넣지 않는다.
OPENAI_API_KEY=

# 팀 Langfuse에 실행 기록이나 점수를 올릴 때 로컬 .env에 설정한다.
# 팀 EC2의 HTTPS 기본 주소와 해당 Langfuse 프로젝트에서 발급한 키 쌍을 사용한다.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 법제처 자치법규 수집(scripts/collect.py)의 인증값(OC). 셸 환경변수로 설정하지 않으면
# 실행 중에 입력받는다. 현재 수집 명령은 .env 파일을 자동으로 읽지 않는다.
LAW_OC=
